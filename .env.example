# AtoJ 애플리케이션 환경변수 설정 템플릿 (.env.example)
# 실제 사용 시 이 파일을 .env로 복사하여 값을 수정하십시오. (.env 파일은 Git에서 제외됨)

# 실행 환경 (development | production | test)
NODE_ENV=production

# 기본 설정 파일(config.json) 경로 오버라이드 (비워두면 실행 위치의 ./config.json 사용)
ATOJ_CONFIG_PATH=./config.json

# SQLite 데이터베이스 파일 경로 (비워두면 ./data/app.db 사용)
ATOJ_DB_PATH=./data/app.db

# 비규격 파일 유입 시 처리 정책 (ignore: 무시 및 보존 | quarantine: 격리 폴더 이동 | delete: 기존처럼 즉시 삭제)
ATOJ_INVALID_FILE_POLICY=ignore

# 비규격 또는 변환 실패 파일 격리 폴더 경로
ATOJ_QUARANTINE_DIR=./quarantine

# 파일 로그 보관 일수 (0이면 자동 삭제 안 함)
ATOJ_LOG_RETENTION_DAYS=30
